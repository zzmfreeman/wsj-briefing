# Shared JS snippet for body image extraction
_JS_EXTRACT_BODY_IMAGE = r"""
() => {
    const skipPatterns = [
        /logo/i, /icon/i, /sprite/i, /pixel/i, /tracking/i,
        /avatar/i, /badge/i, /1x1/i, /spacer/i, /blank\.gif/i,
        /data:image/i, /social-media-icon/, /nav-/, /header-logo/,
        /wsj-logo/, /the-wall-street-journal/, /breadcrumb/
    ];
    function isValidImage(img) {
        const src = img.src || img.getAttribute('data-src') || '';
        if (!src || src.startsWith('data:')) return false;
        if (img.naturalWidth && img.naturalWidth < 100) return false;
        if (img.naturalHeight && img.naturalHeight < 100) return false;
        const w = parseInt(img.getAttribute('width') || '0');
        if (w > 0 && w < 100) return false;
        for (const pat of skipPatterns) {
            if (pat.test(src)) return false;
        }
        if (!src.includes('images.wsj.net') &&
            !src.includes('wsj.net') &&
            !src.includes('wsj.com') &&
            !src.includes('dowjones') &&
            !src.includes('cloudfront') &&
            !src.includes('cdn')) {
            return false;
        }
        return true;
    }
    // Strategy 1: <article> tag
    const articleEl = document.querySelector('article');
    if (articleEl) {
        const imgs = articleEl.querySelectorAll('img');
        for (const img of imgs) {
            if (isValidImage(img)) {
                return (img.src || img.getAttribute('data-src') || '').replace(/&amp;/g, '&');
            }
        }
    }
    // Strategy 2: article-body divs
    const bodySelectors = [
        '[class*="article-body"]', '[class*="articleBody"]',
        '[class*="article-content"]', '[class*="articleContent"]',
        '[class*="story-body"]', '[class*="storyBody"]',
        '[class*="content-body"]', '[class*="main-content"]',
        '[itemprop="articleBody"]'
    ];
    for (const sel of bodySelectors) {
        const container = document.querySelector(sel);
        if (container) {
            const imgs = container.querySelectorAll('img');
            for (const img of imgs) {
                if (isValidImage(img)) {
                    return (img.src || img.getAttribute('data-src') || '').replace(/&amp;/g, '&');
                }
            }
        }
    }
    // Strategy 3: figure elements
    const figures = document.querySelectorAll('figure img, [class*="figure"] img');
    for (const img of figures) {
        if (isValidImage(img)) {
            return (img.src || img.getAttribute('data-src') || '').replace(/&amp;/g, '&');
        }
    }
    // Strategy 4: og:image fallback
    const ogMeta = document.querySelector('meta[property="og:image"]');
    if (ogMeta && ogMeta.content) {
        return ogMeta.content.replace(/&amp;/g, '&');
    }
    return '';
}
"""


